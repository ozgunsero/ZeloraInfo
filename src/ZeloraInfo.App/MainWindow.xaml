<Window x:Class="ZeloraInfo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZeloraInfo.App.ViewModels"
        xmlns:views="clr-namespace:ZeloraInfo.App.Views"
        Title="Zelora Info"
        Icon="pack://application:,,,/Assets/ZeloraInfo.ico"
        Width="1320" Height="860" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.PageBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DiskHealthViewModel}"><views:DiskHealthView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}"><views:BenchmarkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}"><views:SystemView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DisplayViewModel}"><views:DisplayView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}"><views:MemoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CpuDetailsViewModel}"><views:CpuDetailsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RamDetailsViewModel}"><views:RamDetailsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.SidebarBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,12,18">
                    <Image Source="{StaticResource Brand.Icon}" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="18" Foreground="{DynamicResource Brush.TextPrimary}">
                            <Run Text="Zelora" FontWeight="SemiBold" /><Run Text=" Info" Foreground="{DynamicResource Brush.Accent}" />
                        </TextBlock>
                        <TextBlock Text="{Binding VersionText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Privilege status -->
                <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="12,10" CornerRadius="8"
                        Background="{DynamicResource Brush.CardAlt}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Caution}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Good}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="8,0,0,0" Text="{Binding PrivilegeText}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                        </StackPanel>
                        <Button Style="{StaticResource Button.Link}" Margin="12,4,0,0" HorizontalAlignment="Left" FontSize="12"
                                Command="{Binding RestartAsAdminCommand}" Content="{DynamicResource Priv.RestartAsAdmin}"
                                Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavGroups}" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavGroup}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Header}" Margin="24,6,0,6" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding Key}"
                                                             AutomationProperties.Name="{Binding Title}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" Width="22" />
                                                        <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="32,24,32,14">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="{Binding CurrentPage.Title}" />
                <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{Binding CurrentPage.Subtitle}" />
            </StackPanel>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />

            <!-- Toast -->
            <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24"
                    Background="{DynamicResource Brush.Toast}" CornerRadius="8" Padding="16,10"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE930;" Foreground="{DynamicResource Brush.ToastText}" FontSize="14" />
                    <TextBlock Margin="10,0,0,0" Text="{Binding ToastMessage}" Foreground="{DynamicResource Brush.ToastText}" FontSize="13" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
