<UserControl x:Class="ZeloraInfo.App.Views.MemoryMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZeloraInfo.App.ViewModels"
             xmlns:ctl="clr-namespace:ZeloraInfo.App.Controls">
    <UserControl.Resources>
        <!-- Label · value · bar row used by lists, priorities and consumers -->
        <DataTemplate x:Key="BarRowTemplate" DataType="{x:Type vm:BarRow}">
            <StackPanel Margin="0,0,0,9">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ProgressBar Style="{StaticResource ProgressBar.Slim}" Height="6" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                           Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="EmptyButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="IsEnabled" Value="{Binding CanEmpty}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Toolbar -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13" />
                            <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.Refresh}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Base}" Command="{Binding CopyReportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8C8;" FontSize="13" />
                            <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.CopyReport}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Base}" Command="{Binding ExportCommand}" CommandParameter="txt" Content="{DynamicResource Common.ExportTxt}" />
                    <Button Style="{StaticResource Button.Base}" Command="{Binding ExportCommand}" CommandParameter="json" Content="{DynamicResource Common.ExportJson}" />
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="2,-4,0,12">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="6,0,0,0" Text="{Binding SourceText}" />
            </StackPanel>
            <Border Style="{StaticResource Banner.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Composition -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Muted}" Text="{Binding TotalText}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Text.Section}" Margin="0" Text="{DynamicResource Map.Composition}" />
                    </DockPanel>
                    <Border CornerRadius="6" ClipToBounds="True" Height="26" Background="{DynamicResource Brush.Track}">
                        <ItemsControl ItemsSource="{Binding Composition}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><ctl:ProportionalPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="ctl:ProportionalPanel.Weight" Value="{Binding Percent}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CompositionSegment}">
                                    <Border Background="{Binding Brush}" BorderBrush="{DynamicResource Brush.Card}" BorderThickness="0,0,1,0"
                                            ToolTip="{Binding Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Composition}" Focusable="False" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CompositionSegment}">
                                <StackPanel Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Margin="7,0,0,0" Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding BytesText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding PercentText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Lists · priorities · consumers -->
            <UniformGrid Columns="3" Margin="-7,0">
                <Border Style="{StaticResource Card}" Margin="7,0,7,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Map.Lists}" />
                        <ItemsControl ItemsSource="{Binding ListRows}" ItemTemplate="{StaticResource BarRowTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0,7,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Map.Priorities}" />
                        <ItemsControl ItemsSource="{Binding PriorityRows}" ItemTemplate="{StaticResource BarRowTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0,7,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Map.Consumers}" />
                        <ItemsControl ItemsSource="{Binding ConsumerRows}" ItemTemplate="{StaticResource BarRowTemplate}" Focusable="False" />
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Text="{DynamicResource Map.ConsumersNote}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Empty actions + system -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Map.EmptyTitle}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,10" Text="{DynamicResource Map.EmptyIntro}" />
                        <Border Style="{StaticResource Banner}" Padding="12,8"
                                Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Margin="10,0,0,0" Command="{Binding RestartAsAdminCommand}"
                                        Content="{DynamicResource Priv.RestartAsAdmin}" />
                                <TextBlock Text="{DynamicResource Map.EmptyNeedsAdmin}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" />
                            </DockPanel>
                        </Border>
                        <WrapPanel>
                            <Button Style="{StaticResource EmptyButton}" Command="{Binding EmptyCommand}" CommandParameter="WorkingSets" Content="{DynamicResource Map.Empty.WorkingSets}" />
                            <Button Style="{StaticResource EmptyButton}" Command="{Binding EmptyCommand}" CommandParameter="SystemWorkingSet" Content="{DynamicResource Map.Empty.SystemWorkingSet}" />
                            <Button Style="{StaticResource EmptyButton}" Command="{Binding EmptyCommand}" CommandParameter="ModifiedPageList" Content="{DynamicResource Map.Empty.ModifiedPageList}" />
                            <Button Style="{StaticResource EmptyButton}" Command="{Binding EmptyCommand}" CommandParameter="StandbyList" Content="{DynamicResource Map.Empty.StandbyList}" />
                            <Button Style="{StaticResource EmptyButton}" Command="{Binding EmptyCommand}" CommandParameter="PriorityZeroStandbyList" Content="{DynamicResource Map.Empty.PriorityZeroStandbyList}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Map.System}" />
                        <ItemsControl ItemsSource="{Binding SystemRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InfoRow}">
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Processes -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBox DockPanel.Dock="Right" Width="240" Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource Map.ProcessSearch}" AutomationProperties.Name="{DynamicResource Map.ProcessSearch}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Margin="0" Text="{DynamicResource Map.Processes}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding ProcessSummary}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding ProcessView}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserAddRows="False" SelectionMode="Single" Height="420"
                              BorderThickness="0" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource Brush.CardAlt}"
                              HorizontalGridLinesBrush="{DynamicResource Brush.CardBorder}" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name}" Width="*" MinWidth="170"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Map.Col.Process}" /></DataGridTextColumn.Header></DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ProcessId}" Width="Auto" MinWidth="60"><DataGridTextColumn.Header><TextBlock Text="PID" /></DataGridTextColumn.Header></DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding WorkingSet, Converter={StaticResource BytesToText}}" SortMemberPath="WorkingSet" Width="Auto" MinWidth="112"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Map.Col.WorkingSet}" /></DataGridTextColumn.Header></DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PrivateWorkingSet, Converter={StaticResource BytesToText}}" SortMemberPath="PrivateWorkingSet" Width="Auto" MinWidth="112"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Map.Col.PrivateWs}" /></DataGridTextColumn.Header></DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding SharedWorkingSet, Converter={StaticResource BytesToText}}" SortMemberPath="SharedWorkingSet" Width="Auto" MinWidth="112"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Map.Col.SharedWs}" /></DataGridTextColumn.Header></DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PrivateBytes, Converter={StaticResource BytesToText}}" SortMemberPath="PrivateBytes" Width="Auto" MinWidth="112"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Map.Col.Private}" /></DataGridTextColumn.Header></DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PagedPool, Converter={StaticResource BytesToText}}" SortMemberPath="PagedPool" Width="Auto" MinWidth="112"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Map.Col.Paged}" /></DataGridTextColumn.Header></DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding NonPagedPool, Converter={StaticResource BytesToText}}" SortMemberPath="NonPagedPool" Width="Auto" MinWidth="112"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Map.Col.NonPaged}" /></DataGridTextColumn.Header></DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PageFaults, StringFormat={}{0:N0}}" SortMemberPath="PageFaults" Width="Auto" MinWidth="112"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Map.Col.Faults}" /></DataGridTextColumn.Header></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Physical ranges -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Muted}" Text="{Binding RangeSummary}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Text.Section}" Margin="0" Text="{DynamicResource Map.Ranges}" />
                    </DockPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Label}" FontWeight="SemiBold" Text="{DynamicResource Map.Col.Start}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Label}" FontWeight="SemiBold" Text="{DynamicResource Map.Col.End}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Label}" FontWeight="SemiBold" Text="{DynamicResource Map.Col.Size}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Ranges}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RangeRow}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Start}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding End}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Length, Converter={StaticResource BytesToText}}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="0,10,0,0" Text="{DynamicResource Map.Note}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
