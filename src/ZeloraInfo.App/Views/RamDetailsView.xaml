<UserControl x:Class="ZeloraInfo.App.Views.RamDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZeloraInfo.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13" />
                        <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.Refresh}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}" Command="{Binding CopyReportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8C8;" FontSize="13" />
                        <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.CopyReport}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}" Command="{Binding ExportCommand}" CommandParameter="txt" Content="{DynamicResource Common.ExportTxt}" />
                <Button Style="{StaticResource Button.Base}" Command="{Binding ExportCommand}" CommandParameter="json" Content="{DynamicResource Common.ExportJson}" />
                <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Border Style="{StaticResource Banner.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Headline + live usage -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Width="300" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding UsageText}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Ram.Usage}" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ProgressBar.Slim}" Maximum="100" Value="{Binding UsagePercent}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Brush.AccentSoft}">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEEA1;" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="{Binding SlotsSummary}" Style="{StaticResource Text.Muted}" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Sections}" ItemsPanel="{StaticResource Panel.TwoColumns}" Focusable="False" Margin="-7,0">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="7,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <TextBlock Style="{StaticResource Text.Section}" Margin="0,6,0,10" Text="{DynamicResource Ram.Slots}" />
            <ItemsControl ItemsSource="{Binding Slots}" Focusable="False" Margin="-7,0" ItemsPanel="{StaticResource Panel.TwoColumns}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="7,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SlotRow}">
                        <Border x:Name="SlotCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border x:Name="Dot" DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0" Background="{DynamicResource Brush.Good}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPopulated}" Value="False">
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.Unknown}" />
                                <Setter TargetName="SlotCard" Property="Opacity" Value="0.7" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
