<UserControl x:Class="ZeloraInfo.App.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,24">
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13" />
                            <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.Refresh}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Base}" Command="{Binding CopyReportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8C8;" FontSize="13" />
                            <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.CopyReport}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Summary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Style="{StaticResource Banner.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <ItemsControl ItemsSource="{Binding Sections}" ItemsPanel="{StaticResource Panel.TwoColumns}" Focusable="False" Margin="-7,0">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="7,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
