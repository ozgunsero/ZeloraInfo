<UserControl x:Class="ZeloraInfo.App.Views.DiskHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZeloraInfo.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,24">
        <StackPanel>
            <!-- Toolbar -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13" />
                            <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.Refresh}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Base}" Command="{Binding CopyReportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8C8;" FontSize="13" />
                            <TextBlock Margin="8,0,0,0" Text="{DynamicResource Disk.CopySummary}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding LastUpdatedText}" HorizontalAlignment="Right" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding AutoRefreshText}" HorizontalAlignment="Right" />
                </StackPanel>
            </DockPanel>

            <!-- Restricted mode banner -->
            <Border Style="{StaticResource Banner}" Visibility="{Binding IsRestricted, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Brush.Caution}" Margin="0,2,12,0" VerticalAlignment="Top" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Margin="12,0,0,0" VerticalAlignment="Center"
                            Command="{Binding RestartAsAdminCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7EF;" FontSize="13" />
                            <TextBlock Margin="8,0,0,0" Text="{DynamicResource Priv.RestartAsAdmin}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{DynamicResource Priv.RestrictedBanner}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Banner.Error}" Visibility="{Binding HotDiskWarning, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE9CA;" Foreground="{DynamicResource Brush.Bad}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding HotDiskWarning}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Banner.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Loading / empty -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="160" Height="4" VerticalAlignment="Center" />
                <TextBlock Margin="12,0,0,0" Style="{StaticResource Text.Muted}" Text="{DynamicResource Disk.Scanning}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Muted}" Text="{DynamicResource Disk.NoDisks}" Visibility="{Binding HasNoDisks, Converter={StaticResource BoolToVisibility}}" />

            <!-- Disk selector -->
            <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" Background="Transparent" BorderThickness="0"
                     Margin="-4,0,-4,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="10" Padding="14,10" BorderThickness="1"
                                            Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavSelected}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskItemViewModel}">
                        <StackPanel Orientation="Horizontal" MinWidth="200">
                            <Ellipse Width="12" Height="12" Fill="{Binding Health, Converter={StaticResource StatusToBrush}}" VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}">
                                    <Run Text="{Binding HealthText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding TemperatureText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Selected disk -->
            <ContentControl Content="{Binding SelectedDisk}" Focusable="False">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskItemViewModel}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <!-- Health tile -->
                                    <Border CornerRadius="12" Padding="18,16" Margin="0,0,0,14" BorderThickness="2"
                                            Background="{Binding Health, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}"
                                            BorderBrush="{Binding Health, Converter={StaticResource StatusToBrush}}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Disk.Health}" Style="{StaticResource Text.Label}" />
                                            <TextBlock Text="{Binding HealthText}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"
                                                       Foreground="{Binding Health, Converter={StaticResource StatusToBrush}}" />
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding LifeText, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="{DynamicResource Disk.Life}" Style="{StaticResource Text.Label}" />
                                                <TextBlock Text="{Binding LifeText}" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- Temperature tile -->
                                    <Border CornerRadius="12" Padding="18,16" Margin="0,0,0,14" BorderThickness="2"
                                            Background="{Binding TemperatureLevel, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}"
                                            BorderBrush="{Binding TemperatureLevel, Converter={StaticResource StatusToBrush}}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Disk.Temperature}" Style="{StaticResource Text.Label}" />
                                            <TextBlock Text="{Binding TemperatureText}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"
                                                       Foreground="{Binding TemperatureLevel, Converter={StaticResource StatusToBrush}}" />
                                            <TextBlock Text="{Binding TemperatureLevelText}" Style="{StaticResource Text.Muted}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Assessment -->
                                    <Border Style="{StaticResource Card}" Visibility="{Binding Assessment, Converter={StaticResource NullToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Disk.Assessment}" />
                                            <TextBlock Text="{Binding Assessment}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Section}" Text="{Binding Title}" />
                                        <ItemsControl ItemsSource="{Binding Details}" Focusable="False" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Banner.Info}" Visibility="{Binding SmartUnavailableText, Converter={StaticResource NullToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" Margin="0,0,12,0" Foreground="{DynamicResource Brush.Accent}" />
                                    <TextBlock Text="{Binding SmartUnavailableText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- SMART attribute table -->
                            <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasAttributes, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Disk.Attributes}" Margin="18,14,18,8" />
                                    <DataGrid ItemsSource="{Binding Attributes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserResizeRows="False" SelectionMode="Single"
                                              BorderThickness="0" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource Brush.CardAlt}"
                                              HorizontalGridLinesBrush="{DynamicResource Brush.CardBorder}" Margin="8,0,8,10"
                                              ScrollViewer.CanContentScroll="False" PreviewMouseWheel="OnGridMouseWheel">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="28">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Binding="{Binding IdHex}" Width="52"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Disk.Col.Id}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Name}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Disk.Col.Name}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Current}" Width="80"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Disk.Col.Current}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Worst}" Width="80"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Disk.Col.Worst}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Threshold}" Width="80"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Disk.Col.Threshold}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Raw}" Width="170" FontFamily="{StaticResource Font.Mono}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Disk.Col.Raw}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding StatusText}" Width="90"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Disk.Col.Status}" /></DataGridTextColumn.Header></DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
