<UserControl x:Class="ZeloraInfo.App.Views.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZeloraInfo.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="7,0,7,14" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,24">
        <StackPanel>
            <!-- Toolbar -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13" />
                        <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.Refresh}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}" Command="{Binding CopyReportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8C8;" FontSize="13" />
                        <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.CopyReport}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}" Command="{Binding ExportCommand}" CommandParameter="txt" Content="{DynamicResource Common.ExportTxt}" />
                <Button Style="{StaticResource Button.Base}" Command="{Binding ExportCommand}" CommandParameter="json" Content="{DynamicResource Common.ExportJson}" />
                <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Border Style="{StaticResource Banner.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Style="{StaticResource Text.Muted}" Text="{DynamicResource Gpu.NoAdapters}" Margin="0,0,0,12"
                       Visibility="{Binding HasNoAdapters, Converter={StaticResource BoolToVisibility}}" />

            <!-- Adapter selector (only when there is more than one GPU) -->
            <ListBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" Background="Transparent" BorderThickness="0"
                     Margin="-4,0,-4,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding HasMultipleAdapters, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="10" Padding="14,10" BorderThickness="1"
                                            Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavSelected}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GpuItemViewModel}">
                        <StackPanel MinWidth="220">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Headline -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Width="240" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Metric}" FontSize="18" Text="{Binding UtilizationText}" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Gpu.Utilization}" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ProgressBar.Slim}" Maximum="100" Value="{Binding Utilization}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Brush.AccentSoft}">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xF211;" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="{Binding Subline}" Style="{StaticResource Text.Muted}" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Live sensor tiles -->
            <UniformGrid Columns="4" Margin="-7,0">
                <Border Style="{StaticResource Tile}" BorderThickness="2"
                        BorderBrush="{Binding TemperatureLevel, Converter={StaticResource StatusToBrush}}"
                        Background="{Binding TemperatureLevel, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Gpu.Temperature}" />
                        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding TemperatureText}" Margin="0,4,0,0"
                                   Foreground="{Binding TemperatureLevel, Converter={StaticResource StatusToBrush}}" />
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="11.5" Text="{Binding TemperatureLimitText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Gpu.CoreClock}" />
                        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding CoreClockText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="11.5" Text="{Binding CoreClockDetail}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Gpu.MemoryClock}" />
                        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding MemoryClockText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="11.5" Text="{Binding MemoryClockDetail}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Gpu.Fan}" />
                        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding FanText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="11.5" Text="{Binding FanDetail}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Memory & power -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VramText}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Gpu.VramUsage}" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ProgressBar.Slim}" Maximum="100" Value="{Binding VramPercent}" Margin="0,6,0,14" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PowerText}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Gpu.Power}" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ProgressBar.Slim}" Maximum="100" Value="{Binding Power}" Margin="0,6,0,14"
                                     Foreground="{DynamicResource Brush.Write}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SharedText}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Gpu.SharedUsage}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <!-- Engines -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Gpu.Engines}" />
                        <ItemsControl ItemsSource="{Binding Engines}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GpuEngineRow}">
                                    <StackPanel Margin="0,0,14,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource ProgressBar.Slim}" Height="5" Maximum="100" Value="{Binding Percent}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding Sections}" ItemsPanel="{StaticResource Panel.TwoColumns}" Focusable="False" Margin="-7,0">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="7,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
