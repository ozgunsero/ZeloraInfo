<UserControl x:Class="ZeloraInfo.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lic="clr-namespace:ZeloraInfo.Core.Licensing;assembly=ZeloraInfo.Core"
             xmlns:views="clr-namespace:ZeloraInfo.App.Views">

    <TabControl Margin="32,0,32,24" SelectedIndex="{Binding SelectedTabIndex}" Style="{StaticResource TabControl.Pills}">
        <!-- ===================== Overview ===================== -->
        <TabItem AutomationProperties.Name="{DynamicResource About.Tab.Overview}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="14" />
                    <TextBlock Margin="8,0,0,0" Text="{DynamicResource About.Tab.Overview}" />
                </StackPanel>
            </TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Identity -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource Brand.Logo}" Width="180" Height="180" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="30" Foreground="{DynamicResource Brush.TextPrimary}">
                            <Run Text="Zelora" FontWeight="SemiBold" /><Run Text=" Info" Foreground="{DynamicResource Brush.Accent}" />
                        </TextBlock>
                        <TextBlock Text="{DynamicResource App.Tagline}" Style="{StaticResource Text.PageSubtitle}" />
                        <TextBlock Text="{DynamicResource About.Description}" Style="{StaticResource Text.Value}" Margin="0,12,0,12" />
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
                        <TextBlock Text="{Binding Copyright}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Apache 2.0 summary -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A5;" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource Text.Section}" Margin="0" Text="{DynamicResource About.LicenseSection}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Value}" Text="{DynamicResource About.LicenseIntro}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="Copyright 2026 Şero Teknoloji — Apache License, Version 2.0 (SPDX: Apache-2.0)" Margin="0,0,0,12" />
                    <UniformGrid Columns="2">
                        <Border CornerRadius="8" Padding="14,10" Margin="0,0,8,8" Background="{DynamicResource Brush.GoodSoft}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Good}" Text="{DynamicResource About.Permissions}" />
                                <TextBlock Style="{StaticResource Text.Value}" FontSize="12.5" Text="{DynamicResource About.PermissionsText}" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,8" Background="{DynamicResource Brush.UnknownSoft}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="{DynamicResource About.Conditions}" />
                                <TextBlock Style="{StaticResource Text.Value}" FontSize="12.5" Text="{DynamicResource About.ConditionsText}" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="14,10" Margin="0,0,8,0" Background="{DynamicResource Brush.CautionSoft}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Caution}" Text="{DynamicResource About.Limitations}" />
                                <TextBlock Style="{StaticResource Text.Value}" FontSize="12.5" Text="{DynamicResource About.LimitationsText}" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="14,10" Background="{DynamicResource Brush.BadSoft}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Bad}" Text="{DynamicResource About.Warranty}" />
                                <TextBlock Style="{StaticResource Text.Value}" FontSize="12.5" Text="{DynamicResource About.WarrantyText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding OpenLicenseCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A5;" FontSize="13" />
                            <TextBlock Margin="8,0,0,0" Text="{DynamicResource About.OpenLicense}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Third-party -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8F1;" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource Text.Section}" Margin="0" Text="{DynamicResource About.ThirdPartySection}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Value}" Text="{DynamicResource About.ThirdPartyIntro}" Margin="0,0,0,10" />
                    <Border Style="{StaticResource Banner.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    </Border>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Label}" FontWeight="SemiBold" Text="{DynamicResource Col.Component}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Label}" FontWeight="SemiBold" Text="{DynamicResource Col.Version}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Label}" FontWeight="SemiBold" Text="{DynamicResource Col.License}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Label}" FontWeight="SemiBold" Text="{DynamicResource Col.Purpose}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource Text.Label}" FontWeight="SemiBold" Text="{DynamicResource Col.Link}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Components}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type lic:ThirdPartyComponent}">
                                <Border BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,1,0,0" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Value}" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Value}" Text="{Binding Version}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Value}" Text="{Binding License}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Value}" FontSize="12.5" Text="{Binding PurposeText}" Margin="0,0,10,0" />
                                        <Button Grid.Column="4" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Content="{DynamicResource Common.OpenLink}"
                                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding ProjectUrl}" ToolTip="{Binding ProjectUrl}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding OpenThirdPartyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8F1;" FontSize="13" />
                            <TextBlock Margin="8,0,0,0" Text="{DynamicResource About.OpenThirdParty}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
        </TabItem>

        <!-- ===================== Apache 2.0 ===================== -->
        <TabItem AutomationProperties.Name="{DynamicResource Nav.License}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A5;" FontSize="14" />
                    <TextBlock Margin="8,0,0,0" Text="{DynamicResource Nav.License}" />
                </StackPanel>
            </TabItem.Header>
            <views:LicenseView DataContext="{Binding License}" />
        </TabItem>

        <!-- ===================== Third-party ===================== -->
        <TabItem AutomationProperties.Name="{DynamicResource Nav.ThirdParty}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8F1;" FontSize="14" />
                    <TextBlock Margin="8,0,0,0" Text="{DynamicResource Nav.ThirdParty}" />
                </StackPanel>
            </TabItem.Header>
            <views:ThirdPartyView DataContext="{Binding ThirdParty}" />
        </TabItem>
    </TabControl>
</UserControl>
