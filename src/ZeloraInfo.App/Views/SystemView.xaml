<UserControl x:Class="ZeloraInfo.App.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13" />
                        <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.Refresh}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}" Command="{Binding CopyReportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8C8;" FontSize="13" />
                        <TextBlock Margin="8,0,0,0" Text="{DynamicResource Sys.CopyReport}" />
                    </StackPanel>
                </Button>
                <ProgressBar IsIndeterminate="True" Width="120" Height="4" Margin="8,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Border Style="{StaticResource Banner.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Live tiles -->
            <UniformGrid Columns="4" Margin="-7,0,-7,0">
                <Border Style="{StaticResource Card}" Margin="7,0,7,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Sys.CpuUsage}" />
                        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding CpuUsageText}" Margin="0,4,0,8" />
                        <ProgressBar Style="{StaticResource ProgressBar.Slim}" Maximum="100" Value="{Binding CpuUsage}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0,7,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Sys.CurrentClock}" />
                        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding ClockText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0,7,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Sys.Uptime}" />
                        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding UptimeText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0,7,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Sys.OsSection}" />
                        <TextBlock Text="{Binding OsShort}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <ItemsControl ItemsSource="{Binding Sections}" ItemsPanel="{StaticResource Panel.TwoColumns}" Focusable="False" Margin="-7,0">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="7,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
