<UserControl x:Class="ZeloraInfo.App.Views.CpuDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZeloraInfo.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13" />
                        <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.Refresh}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}" Command="{Binding CopyReportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8C8;" FontSize="13" />
                        <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.CopyReport}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}" Command="{Binding ExportCommand}" CommandParameter="txt" Content="{DynamicResource Common.ExportTxt}" />
                <Button Style="{StaticResource Button.Base}" Command="{Binding ExportCommand}" CommandParameter="json" Content="{DynamicResource Common.ExportJson}" />
                <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Border Style="{StaticResource Banner.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Headline -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Width="220" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Metric}" FontSize="18" Text="{Binding UsageText}" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Cpu.Usage}" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ProgressBar.Slim}" Maximum="100" Value="{Binding Usage}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Brush.AccentSoft}">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE950;" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="{Binding Subline}" Style="{StaticResource Text.Muted}" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Banner.Info}" Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" />
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Cpu.Clocks}" />
                            <ItemsControl ItemsSource="{Binding ClockRows}" Focusable="False" />
                        </StackPanel>
                    </Border>

                    <!-- Quick benchmark -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Cpu.Bench}" />
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Cpu.Bench.Single}" />
                                    <TextBlock Style="{StaticResource Text.Metric}" FontSize="28" Text="{Binding SingleScore}" Foreground="{DynamicResource Brush.Read}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Cpu.Bench.MultiShort}" />
                                    <TextBlock Style="{StaticResource Text.Metric}" FontSize="28" Text="{Binding MultiScore}" Foreground="{DynamicResource Brush.Write}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding RatioText}" Margin="0,0,0,8"
                                       Visibility="{Binding RatioText, Converter={StaticResource NullToVisibility}}" />
                            <ProgressBar Style="{StaticResource ProgressBar.Slim}" Maximum="100" Value="{Binding BenchProgress}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding BenchStatus}" Margin="0,6,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Primary}" Command="{Binding RunBenchmarkCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE768;" FontSize="13" />
                                        <TextBlock Margin="8,0,0,0" Text="{DynamicResource Cpu.Bench.Start}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Danger}" Command="{Binding CancelBenchmarkCommand}" Content="{DynamicResource Common.Cancel}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,10,0,0" FontSize="11.5" Text="{DynamicResource Cpu.Bench.Note}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Instructions -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Cpu.Instructions}" />
                    <ItemsControl ItemsSource="{Binding Instructions}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="9,4" Margin="0,0,6,6" Background="{DynamicResource Brush.AccentSoft}">
                                    <TextBlock Text="{Binding}" FontSize="12" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.TextPrimary}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Per logical processor -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Cpu.PerCore}" />
                    <ItemsControl ItemsSource="{Binding CoreRows}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CoreRow}">
                                <Border Width="132" CornerRadius="8" Padding="10,8" Margin="0,0,8,8" Background="{DynamicResource Brush.CardAlt}"
                                        BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding UsageText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Frequency}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,2,0,6" />
                                        <ProgressBar Style="{StaticResource ProgressBar.Slim}" Height="5" Maximum="100" Value="{Binding Usage}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
