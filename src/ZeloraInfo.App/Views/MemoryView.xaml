<UserControl x:Class="ZeloraInfo.App.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ZeloraInfo.App.Views">
    <!-- RAM page: Overview · Details / SPD · Memory Map -->
    <TabControl Margin="32,0,32,24" SelectedIndex="{Binding SelectedTabIndex}" Style="{StaticResource TabControl.Pills}">
        <TabItem AutomationProperties.Name="{DynamicResource Mem.Tab.Overview}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE964;" FontSize="14" />
                    <TextBlock Margin="8,0,0,0" Text="{DynamicResource Mem.Tab.Overview}" />
                </StackPanel>
            </TabItem.Header>
            <views:MemoryOverviewView DataContext="{Binding Overview}" />
        </TabItem>
        <TabItem AutomationProperties.Name="{DynamicResource Mem.Tab.Details}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEEA1;" FontSize="14" />
                    <TextBlock Margin="8,0,0,0" Text="{DynamicResource Mem.Tab.Details}" />
                </StackPanel>
            </TabItem.Header>
            <views:RamDetailsView DataContext="{Binding Details}" />
        </TabItem>
        <TabItem AutomationProperties.Name="{DynamicResource Mem.Tab.Map}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE809;" FontSize="14" />
                    <TextBlock Margin="8,0,0,0" Text="{DynamicResource Mem.Tab.Map}" />
                </StackPanel>
            </TabItem.Header>
            <views:MemoryMapView DataContext="{Binding Map}" />
        </TabItem>
    </TabControl>
</UserControl>
