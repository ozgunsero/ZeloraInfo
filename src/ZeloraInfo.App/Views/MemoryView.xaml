<UserControl x:Class="ZeloraInfo.App.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13" />
                        <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.Refresh}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Base}" Command="{Binding CopyReportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8C8;" FontSize="13" />
                        <TextBlock Margin="8,0,0,0" Text="{DynamicResource Common.CopyReport}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border Style="{StaticResource Banner.Error}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Usage -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Metric}" Text="{Binding UsagePercent, StringFormat={}{0:0} %}" />
                        <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource Mem.Usage}" />
                    </DockPanel>
                    <ProgressBar Style="{StaticResource ProgressBar.Slim}" Height="12" Maximum="100" Value="{Binding UsagePercent}" Margin="0,4,0,14" />
                    <UniformGrid Columns="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Mem.Total}" />
                            <TextBlock Style="{StaticResource Text.Value}" FontSize="16" FontWeight="SemiBold" Text="{Binding TotalText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Mem.Used}" />
                            <TextBlock Style="{StaticResource Text.Value}" FontSize="16" FontWeight="SemiBold" Text="{Binding UsedText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Mem.Free}" />
                            <TextBlock Style="{StaticResource Text.Value}" FontSize="16" FontWeight="SemiBold" Text="{Binding FreeText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource Mem.Commit}" />
                            <TextBlock Style="{StaticResource Text.Value}" FontSize="16" FontWeight="SemiBold" Text="{Binding CommitText}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,6,0,10">
                <TextBlock Style="{StaticResource Text.Muted}" DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding SlotsText}" />
                <TextBlock Style="{StaticResource Text.Section}" Margin="0" Text="{DynamicResource Mem.Modules}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,12" Text="{DynamicResource Mem.NoModules}"
                       Visibility="{Binding HasModules, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Modules}" ItemsPanel="{StaticResource Panel.TwoColumns}" Focusable="False" Margin="-7,0">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="7,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
