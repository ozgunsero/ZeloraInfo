<Application x:Class="ZeloraInfo.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ZeloraInfo.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.Midnight.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
