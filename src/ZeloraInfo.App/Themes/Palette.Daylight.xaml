<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Zelora Info palette — light (airy surfaces, near-black text for contrast) -->
    <SolidColorBrush x:Key="Brush.PageBackground" Color="#F3F6FA" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SidebarBorder" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardAlt" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#DCE3EC" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#0B1220" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#475569" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#64748B" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#0369A1" />
    <SolidColorBrush x:Key="Brush.AccentStrong" Color="#0284C7" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E0F2FE" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.NavHover" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="#E0F2FE" />
    <SolidColorBrush x:Key="Brush.Track" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Brush.BannerWarning" Color="#FFF7E6" />
    <SolidColorBrush x:Key="Brush.BannerWarningBorder" Color="#F59E0B" />
    <SolidColorBrush x:Key="Brush.BannerError" Color="#FEF2F2" />
    <SolidColorBrush x:Key="Brush.BannerErrorBorder" Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.BannerInfo" Color="#EFF8FF" />
    <SolidColorBrush x:Key="Brush.BannerInfoBorder" Color="#0284C7" />
    <SolidColorBrush x:Key="Brush.Toast" Color="#0F172A" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Brush.Good" Color="#15803D" />
    <SolidColorBrush x:Key="Brush.Caution" Color="#B45309" />
    <SolidColorBrush x:Key="Brush.Bad" Color="#B91C1C" />
    <SolidColorBrush x:Key="Brush.Unknown" Color="#64748B" />
    <SolidColorBrush x:Key="Brush.GoodSoft" Color="#DCFCE7" />
    <SolidColorBrush x:Key="Brush.CautionSoft" Color="#FEF3C7" />
    <SolidColorBrush x:Key="Brush.BadSoft" Color="#FEE2E2" />
    <SolidColorBrush x:Key="Brush.UnknownSoft" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Brush.Read" Color="#0369A1" />
    <SolidColorBrush x:Key="Brush.Write" Color="#6D28D9" />
</ResourceDictionary>
